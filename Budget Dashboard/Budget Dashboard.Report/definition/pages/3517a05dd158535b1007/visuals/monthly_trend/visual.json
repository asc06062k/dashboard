{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "monthly_trend",
  "position": {
    "x": 20,
    "y": 730,
    "z": 30,
    "height": 330,
    "width": 1880,
    "tabOrder": 30
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Period"
                    }
                  },
                  "Property": "Month Year"
                }
              },
              "queryRef": "Period.Month Year",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Budget"
                    }
                  },
                  "Property": "Selected Budget"
                }
              },
              "queryRef": "Budget.Selected Budget"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Budget"
                    }
                  },
                  "Property": "Actual Spend"
                }
              },
              "queryRef": "Budget.Actual Spend"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly budget and actual trend (฿)'"
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}