	partition Budget = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("D:\DATA\Dashboard\Budget Dashboard\budget data.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "Budget", Kind = "Sheet"]}[Data],
				  #"Promoted headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"budget_year", Int64.Type}, {"budget_group", type text}, {"budget_sub_group", type text}, {"wbs_element", type text}, {"budget_network", type text}, {"description", type text}, {"item", type text}, {"detail", type text}, {"planning_type", type text}, {"payment_type", type text}, {"budget_owner", type text}, {"period", type date}, {"plan_budget", Int64.Type}, {"approve_budget", Int64.Type}, {"actual", Int64.Type}, {"created_datetime", type datetime}, {"business_datetime", type datetime}, {"month", type date}}),
				  #"Replaced not applicable" = Table.ReplaceValue(#"Changed column type", null, "ไม่เกี่ยวข้อง", Replacer.ReplaceValue, {"budget_network", "item", "detail", "planning_type"})
				in
				  #"Replaced not applicable"

	annotation PBI_NavigationStepName = Navigation

